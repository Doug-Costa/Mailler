// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "rhel-openssl-1.0.x", "rhel-openssl-1.1.x", "rhel-openssl-3.0.x", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SmtpConfig {
  id        String     @id @default(uuid())
  name      String
  host      String
  port      Int
  user      String
  pass      String     // Encrypted
  secure    Boolean    @default(false)
  active    Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  campaigns Campaign[]
}

model Template {
  id        String     @id @default(uuid())
  name      String
  subject   String
  body      String     @db.Text
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  campaigns Campaign[]
}

model Campaign {
  id                        String         @id @default(uuid())
  name                      String
  templateId                String?
  template                  Template?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  smtpConfigId              String?
  smtpConfig                SmtpConfig?    @relation(fields: [smtpConfigId], references: [id], onDelete: SetNull)
  status                    String         @default("PENDING") // PENDING, PROCESSING, PAUSED, COMPLETED, CANCELLED
  totalEmails               Int            @default(0)
  sentEmails                Int            @default(0)
  failedEmails              Int            @default(0)
  openedEmails              Int            @default(0)
  sendingMode               String         @default("IMMEDIATE") // IMMEDIATE, FIXED, RANDOM
  minDelay                  Int            @default(100)        // em ms
  maxDelay                  Int            @default(1000)       // em ms (usado se RANDOM)
  nextCampaignId            String?        @unique
  nextCampaignDelayMinutes  Int            @default(0)
  scheduledStartAt          DateTime?
  nextCampaign              Campaign?      @relation("LinkedCampaigns", fields: [nextCampaignId], references: [id], onDelete: SetNull)
  prevCampaign              Campaign?      @relation("LinkedCampaigns")
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  recipients                RecipientLog[]

  // Attachment fields
  attachmentMode            String         @default("NONE") // NONE, SHARED, INDIVIDUAL
  attachmentColumn          String?
  totalAttachments          Int            @default(0)
  validRecipientsCount      Int            @default(0)
  rejectedRecipientsCount   Int            @default(0)
}

model RecipientLog {
  id                      String    @id @default(uuid())
  campaignId              String
  campaign                Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email                   String
  data                    Json      // Variables parsed from Excel row
  status                  String    @default("PENDING") // PENDING, SENT, FAILED
  opened                  Boolean   @default(false)
  openedAt                DateTime?
  error                   String?
  sentAt                  DateTime?
  createdAt               DateTime  @default(now())

  // Attachment fields
  attachmentOriginalName  String?
  attachmentStorageKey    String?
  attachmentMimeType      String?
  attachmentSize          Int?
  attachmentSha256        String?
  attachmentStatus        String?
  attachmentError         String?

  // Certificate link fields
  certificateId           String?
  certificate             GeneratedCertificate? @relation(fields: [certificateId], references: [id], onDelete: SetNull)
}

model CertificateTemplate {
  id              String                       @id @default(uuid())
  name            String
  description     String?
  backgroundKey   String                       // Storage key of the background image
  width           Float                        // Default width in points (e.g., A4: 841.89)
  height          Float                        // Default height in points (e.g., A4: 595.28)
  orientation     String                       @default("LANDSCAPE") // LANDSCAPE, PORTRAIT
  active          Boolean                      @default(true)
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  versions        CertificateTemplateVersion[]
  batches         CertificateBatch[]
}

model CertificateTemplateVersion {
  id              String             @id @default(uuid())
  templateId      String
  template        CertificateTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version         Int
  configuration   Json               // Layout coordinates, sizes, fonts, colors, transform rules
  backgroundKey   String
  signature1Key   String?            // Optional signature 1 image key
  signature2Key   String?            // Optional signature 2 image key
  createdAt       DateTime           @default(now())
  batches         CertificateBatch[]
}

model CertificateBatch {
  id                String                 @id @default(uuid())
  name              String
  templateId        String
  template          CertificateTemplate    @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateVersionId String
  templateVersion   CertificateTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  status            String                 @default("DRAFT") // DRAFT, GENERATING, GENERATED, FAILED, ARCHIVED
  nameColumn        String
  emailColumn       String?
  idColumn          String?
  filenamePattern   String                 @default("{id}-{nome-normalizado}") // pattern for PDF filenames
  totalRows         Int                    @default(0)
  validRows         Int                    @default(0)
  generatedCount    Int                    @default(0)
  failedCount       Int                    @default(0)
  campaignId        String?                // Optional linked campaign ID
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  certificates      GeneratedCertificate[]
}

model GeneratedCertificate {
  id              String           @id @default(uuid())
  batchId         String
  batch           CertificateBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  sourceRow       Int              // Original row index in Excel
  externalId      String?          // Value from the ID column
  participantName String
  email           String?          // Optional email
  variables       Json             // Full row data JSON
  filename        String           // Real PDF file name (e.g. "001-joao-silva.pdf")
  storageKey      String?          // Key on disk (e.g. "storage/certificate-batches/{batchId}/certificates/{id}.pdf")
  mimeType        String           @default("application/pdf")
  fileSize        Int?
  sha256          String?
  status          String           @default("PENDING") // PENDING, GENERATING, GENERATED, FAILED
  errorMessage    String?
  generatedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  recipientLogs   RecipientLog[]   // Link to campaign recipient log if sent
}
